{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "MediaSettings": {
    "TempDirectory": "Storage/Temp",
    "MaxConcurrentConversions": 2,
    "MaxFileSize": 1073741824,
    "AllowedFormats": [
      "mp3",
      "mp4"
    ],
    "AllowedQualities": [
      "128",
      "192",
      "256",
      "320"
    ]
  }
}
