{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://kingbox-api.onrender.com"
    ]
  },
  "MediaSettings": {
    "YtDlpPath": "yt-dlp",
    "FfmpegPath": "ffmpeg",
    "TempDirectory": "Storage/Temp",
    "MaxConcurrentConversions": 2,
    "MaxFileSize": 1073741824,
    "ProcessTimeoutMinutes": 30,
    "OldJobCleanupHours": 24,
    "AllowedFormats": [
      "mp3",
      "mp4"
    ],
    "AllowedQualities": [
      "128",
      "192",
      "256",
      "320"
    ],
    "JsRuntime": "node",
    "ExtractorArgs": "youtube:player_client=mweb,android;player_skip=webpage,configs"
  }
}
